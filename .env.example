DATABASE_URL=postgres://telegram_bot:telegram_bot@localhost:5432/telegram_bot
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-secret
TELEGRAM_BOT_USERNAME=your_bot_username
GROQ_API_KEY=replace-me
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
PUBLIC_BASE_URL=https://your-service.example.com
AUTO_REGISTER_WEBHOOK=false
PORT=8080
RUST_LOG=telegram_groq_bot=info,tower_http=info

# Optional tuning
# SYSTEM_PROMPT=You are a helpful assistant in a Telegram group. Answer clearly and concisely.
# CONTEXT_MAX_MESSAGES=6
# CONTEXT_MAX_CHARS=6000
# CONTEXT_RETENTION_DAYS=7
# PRIMARY_ANSWER_MAX_TOKENS=1200
# FALLBACK_ANSWER_MAX_TOKENS=1200
# PRIMARY_REQUEST_TOKEN_BUDGET=7000
# FALLBACK_REQUEST_TOKEN_BUDGET=5800
# PRIMARY_DAILY_TOKEN_BUDGET=200000
# FALLBACK_DAILY_TOKEN_BUDGET=500000
# PRIMARY_DAILY_REQUEST_BUDGET=1000
# FALLBACK_DAILY_REQUEST_BUDGET=14400
# PRIMARY_DAILY_SWITCH_PERCENT=80
# RATE_RESERVE_PERCENT=10
# Backoff after a failed worker iteration. Idle queue checks do not use this.
# WORKER_POLL_MILLISECONDS=500
# Longest sleep when no job is queued. Webhook enqueues and scheduled retries wake sooner.
# Keep this above 5 minutes so Neon can suspend. Default is 15 minutes.
# WORKER_IDLE_TIMEOUT_SECONDS=900
# JOB_LEASE_SECONDS=120
# MAX_JOB_ATTEMPTS=8
